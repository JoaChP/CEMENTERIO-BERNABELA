# Copiar a .env y reemplazar estos valores de ejemplo antes de iniciar.
MARIADB_DATABASE=bernabela
MARIADB_USER=bernabela_app
MARIADB_PASSWORD=replace-with-a-local-db-password
MARIADB_ROOT_PASSWORD=replace-with-a-local-root-password
MARIADB_PORT=3306
DATABASE_URL=mysql+pymysql://bernabela_app:replace-with-a-local-db-password@127.0.0.1:3306/bernabela
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_EXPIRE_HOURS=8
