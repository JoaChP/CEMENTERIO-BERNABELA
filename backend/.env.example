# Las variables se cargan desde el archivo .env de la raíz del proyecto.
DATABASE_URL=mysql+pymysql://bernabela_app:replace-with-a-local-db-password@127.0.0.1:3306/bernabela
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_EXPIRE_HOURS=8
